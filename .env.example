# PortfoliFLOW configuration
# Copy this file to .env and adjust as needed.
# All values have sensible defaults — the application runs without a .env file.

APP_NAME=PortfoliFLOW
DEBUG=false
LOG_LEVEL=INFO
DATA_DIR=data
# DB_URL=sqlite:///data/portfoliflow.db

# Postgres credentials for local development (consumed by compose.yml).
# Copy this file to .env and adjust as needed. .env is gitignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_DB=portfoliflow_dev

# App-level connection (used by the application and by the repository test
# suite). Connects as the unprivileged portfoliflow_app role created by
# db/init/01-create-app-role.sql. The password below is the literal
# embedded in that init script for local development; production
# deployments override both the script and this URL via the secret
# manager (Phase 5).
DATABASE_URL=postgresql+asyncpg://portfoliflow_app:app_dev_password_change_me@localhost:5432/portfoliflow_dev

# Superuser connection (used by Alembic to apply DDL and by test fixtures
# to seed/truncate, plus by the `portfoliflow` bootstrap CLI per
# ADR-0040). Never used by application code (FastAPI / bot).
DATABASE_URL_SUPERUSER=postgresql+asyncpg://postgres:postgres_dev_password_change_me@localhost:5432/portfoliflow_dev

# Credential vault master key (ADR-0112 §2) ---------------------------------
# The Fernet key that encrypts every `is_secret` row in `scoped_settings`
# (tenant/user-scope provider credentials). Environment ONLY — it is never
# stored in the database and never committed. Generate one with
# `portfoliflow vault-generate-key`; rotate with `portfoliflow vault-rotate-key`.
# Unset means the vault is DISABLED, loudly: secret rows are not read, the
# admin write path fails with a typed error, and every credential resolution
# falls through to the application scope (i.e. the variables below) — there is
# never a silent plaintext mode. Losing the key means losing every encrypted
# credential value; there is no escrow copy anywhere in the system.
# Custody, rotation and missing-key behaviour: docs/deploy/credential-vault.md.
# CREDENTIAL_VAULT_MASTER_KEY=

# Web server bind & cookie security -----------------------------------------
# Read by web/settings.py (WebSettings). All three have safe local-dev
# defaults; they are listed here because a hosted deployment must review them.
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# SESSION_COOKIE_SECURE — when true, session and CSRF cookies are marked
# `Secure` and are only sent over TLS. MUST be true on any deployment served
# over HTTPS (the hosted/Hetzner instance); false only for plain-HTTP local
# development.
# SESSION_COOKIE_SECURE=false

# Primary-tenant owner (consumed by `portfoliflow bootstrap` per
# ADR-0040 / ADR-0063). The owner logs in at
# http://minathena-capital.localhost:8000 (dev) or the matching
# production subdomain. Supply the password via stdin / secret
# manager in production rather than committing a literal here.
# OWNER_EMAIL / OWNER_PASSWORD are the new names; SENTINEL_EMAIL /
# SENTINEL_PASSWORD remain accepted as a deprecation alias.
OWNER_EMAIL=
# OWNER_PASSWORD=  # provide via `--password-stdin` in production
# OWNER_DISPLAY_NAME — optional human name for the primary-tenant owner
# (ADR-0068). Seeds the Front Office welcome header
# ("Welcome back, {first name} — {tenant} portfolio"). Nullable and
# optional; leave blank to greet without a name. Reaches `bootstrap`
# via the CLI's own dotenv load, so both db-reset.sh and db-init.sh
# pick it up.
OWNER_DISPLAY_NAME=

# First super-admin (optional; created on bootstrap if both vars set).
# When SUPER_ADMIN_EMAIL and SUPER_ADMIN_PASSWORD are both set, the
# bootstrap CLI creates a super-admin in the system tenant inside the
# same transaction. Without these vars the super-admin step is
# skipped; you can create one later with
# `portfoliflow create-super-admin`. Used to log in on
# http://admin.localhost:8000 (dev).
SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=  # provide via `--password-stdin` in production
# SUPER_ADMIN_DISPLAY_NAME — optional human name for the first
# super-admin (ADR-0068). Optional; leave blank to omit.
SUPER_ADMIN_DISPLAY_NAME=

# Tenant resolution — local-dev fallback (per ADR-0063 §1).
# When the request host is bare 'localhost' or '127.0.0.1' (no
# subdomain), the resolver falls back to this tenant subdomain.
# Leave unset if you use /etc/hosts entries like 'admin.localhost'
# and 'minathena-capital.localhost' — those let multiple tenants
# coexist in parallel browser tabs.
# LOCAL_DEV_TENANT_SUBDOMAIN=minathena-capital

# Telegram bot integration (optional, off by default)
# TELEGRAM_BOT_ENABLED is the master switch for the whole bot thread.
# *Which* bots run is a separate question, answered per tenant since
# ADR-0112 §5: each tenant stores its own BotFather token under
# Admin -> Providers & Credentials, and one process polls all of them
# (one Bot + Dispatcher + polling task per token). Token changes apply at
# the next restart. See docs/deploy/telegram-multi-bot.md.
# When enabled the bot runs inside the web process and reads the same
# Postgres data as the web chat, so DATABASE_URL (set above) is REQUIRED —
# an enabled bot with an empty DATABASE_URL fails loudly at startup.
# DATABASE_URL_SUPERUSER is what the cross-tenant token scan runs on;
# without it only the transition token below can serve.
TELEGRAM_BOT_ENABLED=false
# DEPRECATED transition token (ADR-0112 §5). Additive: it spawns one extra
# dispatcher, bound to the SHIRLEY_BOT_TENANT_SUBDOMAIN tenant, and only
# while that tenant has stored no token of its own (its own row wins).
# Leave empty once the token lives in Providers & Credentials.
TELEGRAM_BOT_TOKEN=
# DEPRECATED whitelist (ADR-0112 §5). Authorisation is now the *pairing*
# binding: a user generates a code under Admin -> Providers & Credentials
# and sends `/pair <code>` to the bot from the chat they want to use; the
# bot stores the chat id as a user-scope setting and the turn then runs as
# that user (so their own model applies). This list survives only as a
# fallback on the TELEGRAM_BOT_TOKEN dispatcher above, grants no user
# identity, and warns once at startup. Clear it after pairing.
# Comma-separated Telegram user IDs (use @userinfobot in Telegram to find yours)
TELEGRAM_ALLOWED_USER_IDS=
# DEPRECATED transition config (ADR-0112 §5). Binds TELEGRAM_BOT_TOKEN
# above to one tenant, and nothing else — tenants with their own stored
# token carry their own identity. The web lifespan resolves this subdomain
# to a tenant id (via the superuser/audit engine, which bypasses RLS) and
# injects it into the bot; the bot does not resolve its own tenant
# (ADR-0063). Ignored when TELEGRAM_BOT_TOKEN is empty.
SHIRLEY_BOT_TENANT_SUBDOMAIN=minathena-capital

# Shirley model configuration — the APPLICATION scope of the three-scope
# credential chain (ADR-0112 §1: application -> tenant -> user). These
# values are the fallback consulted when neither the tenant nor the user
# holds a row of their own; per-tenant and per-user values are written
# under Admin -> Providers & Credentials and apply on the *next* turn
# with no restart (ADR-0112 §4b), while a change here needs one, because
# only this scope is read at startup.
# The web chat, the Irene tick and the Telegram bot all resolve through
# the same chain, so configuring it here once serves every surface.
# When nothing resolves anywhere, `POST /chat/messages` returns 503 with
# a pointer to both scopes.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
SHIRLEY_MODEL=

# Irene synthesis model for the Watch Desk beat (ADR-0086/0088).
# Irene is the background analyst (`cli/irene_tick.py`); she must not be
# pinned to Shirley's interactive model. The tick resolves the model per
# tenant and per beat (ADR-0112 §4b), scope-major and Irene-first within
# each scope: tenant `irene_model` -> tenant `model` -> IRENE_MODEL ->
# SHIRLEY_MODEL -> a built-in default (`anthropic/claude-sonnet-4.5`).
# Leave empty to fall back to SHIRLEY_MODEL. Uses the same
# OPENROUTER_BASE_URL / OPENROUTER_API_KEY above; the systemd tick reads
# .env at invocation.
IRENE_MODEL=

# Report Scraper extraction model (ADR-0123).
# The model that reads uploaded GP quarterly reports at
# `/assistants#report-scraper`. Resolved per run, per tenant, in the same
# scope-major shape as IRENE_MODEL and Scraper-first within each scope:
# tenant `scraper_model` -> tenant `model` -> SCRAPER_MODEL ->
# SHIRLEY_MODEL -> a built-in default (`anthropic/claude-sonnet-4.5`).
# Leave empty to fall back to SHIRLEY_MODEL. Uses the same
# OPENROUTER_BASE_URL / OPENROUTER_API_KEY above.
# Whatever resolves must be PDF-capable: the capability map
# (`config/scraper_model_capabilities.json`) ships Anthropic models only,
# and a model outside it is refused loudly before any file is read —
# never silently downgraded.
SCRAPER_MODEL=

# Built-in tick scheduler (ADR-0117) ----------------------------------------
# The tick source: one background task in the web process that asks "who is
# due?" every TICK_SCHEDULER_INTERVAL_SECONDS and beats the due tenants,
# through exactly the pipeline the CLI ticks use. On by default, so a fresh
# install has a working Irene heartbeat and market-data refresh with no
# systemd knowledge required.
# Set TICK_SCHEDULER_ENABLED=false to opt out and drive the ticks externally
# instead (the units under docs/deploy/, cron, or equivalent) — but then
# nothing beats until that external source runs. Both may run at once: every
# beat is claimed with a Postgres advisory lock, so the first claimant beats
# and the other skips, and a systemd deployment can migrate in either order.
# The interval is the *tick* interval, never a cadence — per-tenant cadence
# lives in the database and is edited in the Watch Desk. Accepted range
# 5–3600 seconds; anything else is refused at startup rather than clamped.
# TICK_SCHEDULER_ENABLED=true
# TICK_SCHEDULER_INTERVAL_SECONDS=60

# Voice I/O for Shirley (optional, off by default) — ADR-0076, ADR-0118.
# Turn-based speech-to-text (input) and text-to-speech (output) on the web
# chat and Telegram voice messages. Since ADR-0118 every VOICE_* variable is
# the *application-scope* link of a scoped-settings field: tenant rows written
# under Admin → Providers & Credentials outrank the values here, and both
# surfaces resolve the configuration per request/message — so a change at
# either scope applies on the next voice interaction, with no restart. When
# VOICE_ENABLED=false or a required key is empty, the surfaces hide the voice
# controls and behave exactly as text-only today. STT and TTS are configured
# independently so providers can be mixed. Audio is processed in memory for
# one turn and never persisted. Provider routing does NOT go through
# OpenRouter (it does not proxy audio) — these need their own credentials.
VOICE_ENABLED=false
# --- Speech-to-text -------------------------------------------------------
VOICE_STT_PROVIDER=openai
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_STT_API_KEY=
# Base URL enables an OpenAI-compatible STT swap (e.g. Groq) without a new
# adapter — keep VOICE_STT_PROVIDER=openai and change only this URL.
VOICE_STT_BASE_URL=https://api.openai.com/v1
# --- Text-to-speech -------------------------------------------------------
VOICE_TTS_PROVIDER=openai
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=nova
VOICE_TTS_API_KEY=

# Live market-data import (provider-agnostic ingest) — ADR-0091, roadmap #036.
# OpenFIGI resolves ISIN/ticker → FIGI for the market-data adapters. The key is
# OPTIONAL: resolution works keyless at OpenFIGI's lower anonymous rate limit;
# set a key to raise that limit. Resolution now flows through the provider
# credential resolver (ADR-0095 Stage 1); the variable name and its optionality
# are unchanged. Yahoo needs no credentials. The synthetic
# test-event provider reads its fixture path from MARKET_DATA_SYNTHETIC_FIXTURE
# (see config/market_data_synthetic_example.json); leave it unset in normal
# deployments.
OPENFIGI_API_KEY=
# Synthetic market-data fixture path — TEST SESSIONS ONLY (ADR-0093 §0.4):
# `portfoliflow market-data-tick --provider synthetic` reads it. Leave unset
# in normal deployments.
MARKET_DATA_SYNTHETIC_FIXTURE=
# --- Bloomberg Desktop API (ADR-0091, #036) -------------------------------
# Connection settings for the Bloomberg adapter's local Terminal session. The
# Desktop API listens on localhost:8194 by default; leave these blank to accept
# those defaults. They are CONNECTION settings, not credentials — the running,
# entitled Terminal is the auth/entitlement boundary (the matrix declares
# `bloomberg: none`). The adapter also requires the `blpapi` package, which is
# NOT on public PyPI — install it from Bloomberg's own index:
#   pip install --index-url https://blpapi.bloomberg.com/repository/releases/python/simple/ blpapi
# The bloomberg capability-matrix entry ships `enabled: false`; flip it to
# `true` only on a machine where BOTH the Terminal and blpapi exist. The
# credentialed Server-API / B-PIPE / Data-License variants are #037-gated
# (per-tenant licensed) and are separate future adapters.
BLPAPI_HOST=
BLPAPI_PORT=

# Web surface — upload limits ----------------------------------------------
# Maximum size (megabytes) of an Excel workbook accepted by the Front Office
# data-import upload (web/routes/data_import.py). Read at request time so it
# can be overridden per environment. Optional; default 50.
# WEB_MAX_UPLOAD_SIZE_MB=50

# Cases — attachment caps (ADR-0107) ---------------------------------------
# Per-attachment byte ceiling and per-case attachment count for the Cases
# document pins. Per Gate-C0 decision D6 these are configuration, enforced at
# the route, never in the schema. Optional; defaults below (10 MiB, 20 files).
# CASE_ATTACHMENT_MAX_BYTES=10485760
# CASE_ATTACHMENT_MAX_COUNT=20

{
    "_comment": "PortfoliFLOW UI Theme — Light variant. A neutral light-grey/white office look suitable for daytime work next to Excel/Word. Loaded by gui/theme.py via core/ui_theme.py.",
    "_version": "1.1.0",
    "_display_name": "Light",

    "background": {
        "chrome":    "#FFFFFF",
        "primary":   "#F5F5F5",
        "secondary": "#EAEAEA",
        "section":   "#DEDEDE"
    },

    "accent": {
        "primary":         "#1F6FB2",
        "primary_hover":   "#2E8AD0",
        "primary_pressed": "#155A95",
        "on_accent":       "#FFFFFF",
        "logo":            "#F30A27"
    },

    "button": {
        "fg": "#FFFFFF"
    },

    "text": {
        "_comment":   "primary is the neutral high-emphasis colour since UX A-0 (design parameters §3.2); the brand red is accent.primary and is used for the one primary action, the active navigation marker, focus and the logo only.",
        "primary":    "#1A1A1A",
        "secondary":  "#5A5A5A",
        "tertiary":   "#7A7A7A",
        "disabled":   "#A0A0A0",
        "on_sidebar": "#1A1A1A"
    },

    "border": {
        "default": "#C8C8C8",
        "soft":    "#E0E0E0"
    },

    "font": {
        "family":    "IBM Plex Sans, Inter, Segoe UI, system-ui, sans-serif",
        "size_base": 10,
        "scale": {
            "xs":   "12px",
            "sm":   "13px",
            "md":   "14px",
            "lg":   "16px",
            "xl":   "20px",
            "hero": "40px"
        },
        "weight": {
            "regular":  400,
            "medium":   500,
            "semibold": 600
        }
    },

    "semantic": {
        "_comment_table_bg_dark": "Dark-theme variants used by ADR-0062 heatmap tinting on performance columns (Excess, Alpha, IR, ...). Desaturated dark green / dark red read as a perceptible tint on the canonical #0A0A0A background without overpowering cell text.",
        "success":         "#2E7D32",
        "warning":         "#E0A800",
        "info":            "#1F6FB2",
        "error":           "#C62828",
        "muted":           "#7A7A7A",
        "confidence_low":  "#E65100",
        "table_pos_bg":    "#D6F2D8",
        "table_neg_bg":    "#F7D6D6",
        "table_pos_bg_dark": "#1A3F1F",
        "table_neg_bg_dark": "#3F1A1F",
        "positive":        "#2E7D32",
        "negative":        "#C62828",
        "warn":            "#E65100"
    },

    "space": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "24px",
        "6": "32px",
        "7": "48px"
    },

    "radius": {
        "sm": "4px",
        "md": "8px"
    },

    "control": {
        "height":       "34px",
        "height_sm":    "28px",
        "input_height": "36px",
        "row_pad":      "10px"
    },

    "motion": {
        "duration": "160ms"
    },

    "focus": {
        "width":  "2px",
        "offset": "2px"
    },

    "layout": {
        "nav_width":           "252px",
        "nav_width_collapsed": "56px",
        "rail_width":          "44px",
        "dock_width":          "380px",
        "content_max":         "1664px",
        "reading_width":       "960px",
        "stage_conversation":  "420px"
    },

    "accessible": {
        "_comment": "Overrides applied by the shell under data-a11y=\"on\" (design parameters §2.11); the remapping rule lives in the component layer, not here.",
        "font_scale": {
            "xs": "14px",
            "sm": "16px",
            "md": "17px",
            "lg": "19px",
            "xl": "24px"
        },
        "text_secondary": "#3A3A3A",
        "text_tertiary":  "#5A5A5A",
        "border_default": "#8A8A8A",
        "control": {
            "height":       "44px",
            "height_sm":    "36px",
            "input_height": "44px"
        },
        "layout": {
            "nav_width":           "272px",
            "nav_width_collapsed": "64px",
            "dock_width":          "420px"
        },
        "motion_duration": "0ms"
    },

    "pf": {
        "_comment": "Web-shell tokens emitted under --pf-* by scripts/generate_theme_artifacts.py. The stepper palette was retired with the single-button Data Import refactor (sub-stream 6F)."
    }
}

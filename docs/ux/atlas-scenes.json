  {
    "name": "cases-file-waiting",
    "area": "cases",
    "start": "/cases",
    "session": "tenant",
    "steps": [
      {"wait": "#cs-list"},
      {"ensure": {"selector": "[data-pf-cs=\"row\"]:has-text(\"Atlas waiting case\")",
                  "steps": [
                    {"click": "[data-pf-cs=\"new-action\"]"},
                    {"wait": ".pf-cases__new-form"},
                    {"fill": {"selector": ".pf-cases__new-form input[name=\"title\"]", "value": "Atlas waiting case"}},
                    {"click": ".pf-cases__new-form button[type=\"submit\"]"},
                    {"wait": "[data-pf-cs=\"file\"]"},
                    {"click": "[data-pf-cs=\"action\"][data-pf-cs-kind=\"wait\"]"},
                    {"wait": "[name=\"wait_until\"]"},
                    {"fill": {"selector": "[name=\"wait_until\"]", "value": "2030-01-15"}},
                    {"click": "#case-composer-slot button[type=\"submit\"]"},
                    {"wait": "[data-pf-cs=\"state\"][data-pf-cs-state=\"waiting\"]"},
                    {"click": "[data-pf-cs=\"crumb\"] .pf-crumb__back"},
                    {"wait": "#cs-list"}
                  ]}},
      {"click": "[data-pf-cs=\"row\"]:has-text(\"Atlas waiting case\") a"},
      {"wait": "[data-pf-cs=\"file\"]"}
    ],
    "shot": "case-file-waiting"
  },
  {
    "name": "cases-list-closed",
    "area": "cases",
    "start": "/cases",
    "session": "tenant",
    "steps": [
